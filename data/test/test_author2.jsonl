{"id": "a059", "fonte": "llm_autor2", "texto": "Sou vegetariano, pode colocar atum.", "limite_schema": true, "rotulo": {"intencao": "pedido", "categorias": [], "excluir_categorias": [], "excluir_ingredientes": [], "restricoes": ["vegetariano"], "restricoes_parciais": [], "alerta_saude": false, "preco_max": null, "frete_gratis": false, "tempo_max_min": null, "nota_min": null, "pessoas": null, "desejos": []}}
{"id": "a060", "fonte": "llm_autor2", "texto": "Quero uma opção vegana com queijo normal. É pro meu namorado, eu quero a vegana.", "limite_schema": true, "rotulo": {"intencao": "pedido", "categorias": [], "excluir_categorias": [], "excluir_ingredientes": [], "restricoes": [], "restricoes_parciais": ["vegano"], "alerta_saude": false, "preco_max": null, "frete_gratis": false, "tempo_max_min": null, "nota_min": null, "pessoas": 2, "desejos": []}}
{"id": "a061", "fonte": "llm_autor2", "texto": "oi eu queria ver se tem uma comida assim de panela arroz feijão uma carninha mas sem gordura porque da última vez veio só nervo e eu não consegui comer direito", "limite_schema": false, "rotulo": {"intencao": "pedido", "categorias": [], "excluir_categorias": [], "excluir_ingredientes": ["gordura"], "restricoes": [], "restricoes_parciais": [], "alerta_saude": false, "preco_max": null, "frete_gratis": false, "tempo_max_min": null, "nota_min": null, "pessoas": null, "desejos": ["caseiro"]}}
